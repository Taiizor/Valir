<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>Valir.EntityFrameworkCore</PackageId>
        <Description>Transactional Outbox pattern for Valir using Entity Framework Core. Ensures atomic job creation with database transactions for reliable message delivery.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Valir.Abstractions\Valir.Abstractions.csproj" />
        <ProjectReference Include="..\Valir.Core\Valir.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    </ItemGroup>

</Project>
